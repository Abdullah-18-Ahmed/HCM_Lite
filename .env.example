# HCM Lite configuration (contracts/configuration.md). Copy to .env and fill in.
# Placeholders only. Never commit real secrets.

# --- OpenAI (required) ---
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Database (async SQLAlchemy URL; treated as a secret) ---
# Leave DATABASE_URL unset to use the default below. Do NOT put it in .env: Chainlit
# also loads .env and treats a set DATABASE_URL as its own POSTGRES persistence layer,
# which crashes sign-in with ModuleNotFoundError: asyncpg.
# DATABASE_URL=sqlite+aiosqlite:///./data/hcm_lite.db

# --- REST API auth ---
# Required, at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
API_JWT_SECRET=
API_TOKEN_MINUTES=60
# Comma-separated origins; empty = CORS off.
API_CORS_ORIGINS=

# --- Sessions and sign-in ---
SESSION_IDLE_MINUTES=60
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# --- Vector store (Qdrant only) ---
VECTOR_STORE_PROVIDER=qdrant
VECTOR_STORE_PATH=.qdrant
# Leave empty for embedded mode; set for Qdrant server mode.
VECTOR_STORE_URL=
VECTOR_STORE_API_KEY=
VECTOR_STORE_COLLECTION=hr_documents

# --- RAG ---
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
DOCUMENTS_DIR=data/demo/documents

# --- Application ---
APP_TIMEZONE=UTC
LATE_GRACE_MINUTES=0
AGENT_MAX_TURNS=8
MODEL_TIMEOUT_SECONDS=30
